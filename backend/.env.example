DJANGO_SECRET_KEY=replace-me
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=kova
POSTGRES_USER=kova
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Railway Postgres fills this in. Leave it empty locally.
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0

# Public site. Product links and the Facebook return address use this.
FRONTEND_URL=http://localhost:3000

# Browser origin allowed to call the API with the login cookie.
CORS_ALLOWED_ORIGINS=http://localhost:3000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_VISION_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Kova

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=kova

# Optional Railway volume so product photos survive a redeploy.
MEDIA_ROOT=
