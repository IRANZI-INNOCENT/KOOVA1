DJANGO_SECRET_KEY=replace-me
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=kova
POSTGRES_USER=kova
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Railway Postgres fills this in. Leave it empty locally.
DATABASE_URL=

REDIS_URL=redis://localhost:6379/0

# Public site. Product links and the Facebook return address use this.
FRONTEND_URL=http://localhost:3000

# Browser origin allowed to call the API with the login cookie.
CORS_ALLOWED_ORIGINS=http://localhost:3000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_VISION_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
# Public URL of the Django API (for Meta to fetch /media/ images). On Railway, use https://<api-service>.up.railway.app
API_PUBLIC_URL=
OPENROUTER_APP_NAME=Kova

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=kova

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. Defaults to FRONTEND_URL + /api/professional/linkedin/callback/
LINKEDIN_REDIRECT_URI=

# Railway: mount a volume at /data and set MEDIA_ROOT=/data/media.
# If unset on Railway, production defaults to /data/media when RAILWAY_* is present.
MEDIA_ROOT=

# Production only (set on Railway API service, not in local .env):
# DJANGO_SETTINGS_MODULE=config.settings.production  (web.sh sets this)
# DATABASE_URL=  (from Postgres plugin reference)
